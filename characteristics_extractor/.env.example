# Скопируйте в .env: HTTP-сервис и CLI загружают его автоматически при запуске.
# Отладочный вывод HTTP-запросов, этапов, ответов LLM и ошибок в терминал.
EXTRACTOR_DEBUG_PRINT=false
LM_STUDIO_BASE_URL=http://localhost:1234/v1
# Точный id, проверенный на локальном сервере; сверьте с GET /v1/models.
LM_STUDIO_MODEL=qwen/qwen3.8-27b
LM_STUDIO_REASONING_EFFORT=none
LM_STUDIO_TIMEOUT_SECONDS=120
LM_STUDIO_CONNECT_TIMEOUT_SECONDS=5
LM_STUDIO_MAX_TOKENS=2048
LM_STUDIO_TEMPERATURE=0.7
LM_STUDIO_TOP_P=0.8
LM_STUDIO_TOP_K=20
LM_STUDIO_PRESENCE_PENALTY=1.5
LM_STUDIO_REPEAT_PENALTY=1.0
LM_STUDIO_MAX_RESPONSE_BYTES=1000000
LM_STUDIO_MAX_PROMPT_CHARS=100000
# LM_STUDIO_API_KEY=...
# KTRU_DB_PATH=/absolute/path/to/ktru.db
EXTRACTOR_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
