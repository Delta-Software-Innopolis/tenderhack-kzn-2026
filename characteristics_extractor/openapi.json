                "number": "#/components/schemas/OriginalNumber",
                "string": "#/components/schemas/OriginalString"
              }
            }
          },
          "characteristic_id": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
