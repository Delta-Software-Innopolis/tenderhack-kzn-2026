                    "string": "#/components/schemas/NormalizedString"
                  }
                }
              },
              {
                "type": "null"
              }
            ],
            "title": "Normalized Value",
            "description": "Вычисляется сервером по выбранной характеристике КТРУ"
          },
          "extracted_name": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              {
                "type": "null"
              }
