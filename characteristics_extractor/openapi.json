{
  "openapi": "3.1.0",
  "info": {
    "title": "Characteristics Extractor",
    "description": "Stateless-извлечение характеристик КТРУ. Принимает ответ поиска целиком. При уточнении принимает собственный ответ с изменёнными attributes. Кандидаты не фильтруются.",
    "version": "0.1.0"
  },
  "paths": {
    "/health": {
      "get": {
        "tags": [
          "Состояние"
        ],
        "summary": "Проверить доступность сервиса",
        "description": "Проверяет только HTTP-процесс. Не обращается к LM Studio и базе КТРУ.",
        "operationId": "getHealth",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/extract": {
      "post": {
        "tags": [
          "Характеристики"
        ],
        "summary": "Извлечь характеристики или обработать уточнение",
        "description": "**Первый вызов:** передайте JSON-ответ поиска целиком: `query`, `canonical_query`,\n`lemmatized_query`, `candidates`. Поле `attributes` отсутствует или равно `null`.\nСервис загрузит справочник по кодам кандидатов и один раз вызовет LM Studio.\nПоле `search_target` в ответе — название искомого товара без характеристик:\nнапример, для «Молоток с рукоятью 15 см» оно равно «Молоток».\nЕсли товар не назван однозначно, `search_target=null`; первый кандидат не подставляется.\nИзвлекаются явные и неявные свойства с конкретными значениями. Кандидаты не фильтруются.\n\n**Уточнение:** отправьте весь полученный документ на этот же endpoint.\nВ нужном атрибуте заполните `characteristic_id` из вариантов либо исправьте\n`original_value` / `original_value.unit`, поставьте `resolution_source: user`\nи очистите `clarifications`. Сохраните `search_target`, `characteristic_options`, исходные запросы,\nкандидатов и `input_fingerprint`. Повторный вызов не использует LLM или сессии.\nСервер заново вычислит названия, нормализованные значения и оставшиеся вопросы.\nПустой `attributes: []` означает продолжение без свойств, а не новый разбор.\n\n**HTTP 200** может содержать `status: needs_clarification`: показывайте\n`clarifications` и блокирующие `issues`. Неизвестное свойство помечается\n`status: unknown` и сообщением «Неизвестная характеристика».\nНеравенства, отрицания, диапазоны и альтернативы возвращаются как\n`unsupported_constraint`; для них исправьте исходный запрос и начните новый разбор.\n\nДля нового текста/набора кандидатов сбросьте `attributes` и `input_fingerprint`\nв `null`, `clarifications` и `issues` в `[]`. Контрольная сумма не является\nподписью или токеном авторизации. Межполевые проверки выполняются Python\nдополнительно к JSON Schema.",
        "operationId": "extractCharacteristics",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ExtractRequest"
              },
              "examples": {
                "initial": {
                  "summary": "Первичный запрос из сервиса поиска",
                  "description": "Минимальный пример с одним кандидатом. Можно передать весь список кандидатов.",
                  "value": {
                    "query": "Молоток рукоять 15 см",
                    "canonical_query": "Молоток рукоять 15 см",
                    "lemmatized_query": "молоток рукоять 15 см",
                    "candidates": [
                      {
                        "ktru_code": "25.73.30.141-00000001",
                        "name": "Молоток",
                        "status": "ACTIVE",
                        "okpd2_code": "25.73.30.141",
                        "rrf_score": 0.02967032967032967,
                        "is_template": false
                      }
                    ]
                  }
                }
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Разбор завершён или требуется пользовательское уточнение; смотрите status, clarifications и issues.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ExtractResponse"
                }
              }
            }
          },
          "409": {
            "description": "Неполный справочник КТРУ; detail.code=incomplete_catalog, причины в detail.issues.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ServiceError"
                }
              }
            }
          },
          "422": {
            "description": "Ошибка структуры входа (detail — массив) или состояния уточнения (detail — объект с code=invalid_state).",
            "content": {
              "application/json": {
                "schema": {
                  "anyOf": [
                    {
                      "$ref": "#/components/schemas/ServiceError"
                    },
                    {
                      "$ref": "#/components/schemas/RequestValidationErrorResponse"
                    }
                  ],
                  "title": "Response 422 Extractcharacteristics"
                },
                "examples": {
                  "invalid_state": {
                    "summary": "Изменён контекст уточнения",
                    "value": {
                      "detail": {
                        "code": "invalid_state",
                        "message": "Изменился запрос/список кандидатов или отсутствует input_fingerprint. Отправьте attributes=null."
                      }
                    }
                  },
                  "validation": {
                    "summary": "Нет обязательного поля",
                    "value": {
                      "detail": [
                        {
                          "loc": [
                            "body",
                            "query"
                          ],
                          "msg": "Field required",
                          "type": "missing",
                          "input": {}
                        }
                      ]
                    }
                  }
                }
              }
            }
          },
          "502": {
            "description": "Некорректный/обрезанный ответ LLM или превышение лимита: llm_invalid_output, llm_output_truncated, llm_size_limit.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ServiceError"
                }
              }
            }
          },
          "503": {
            "description": "LM Studio или КТРУ недоступны либо модель не настроена: llm_unavailable, catalog_unavailable, configuration_error.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ServiceError"
                }
              }
            }
          },
          "504": {
            "description": "Истёк срок ожидания LM Studio: llm_timeout.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ServiceError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Attribute": {
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S",
            "title": "Id"
          },
          "source_text": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S",
            "title": "Source Text",
            "description": "Дословный фрагмент исходного query"
          },
