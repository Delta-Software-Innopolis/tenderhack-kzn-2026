<?xml version='1.0' encoding='UTF-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_Ktru" targetNamespace="https://tenderhack.local/bpmn/ktru" name="Подбор КТРУ по описанию товара" exporter="Codex" exporterVersion="1.0">
  <!-- BPMN 2.0; descriptive model; repository revision 1473edef775040f57ed19d12730ad5ac7198eb00; reviewed 2026-10-11. -->
  <bpmn:dataStore id="DataStore_Ktru" name="Каталог КТРУ и поисковые индексы" isUnlimited="true">
    <bpmn:documentation>ktru.db: позиции, характеристики, допустимые значения, ОКЕИ, FTS5 и эмбеддинги. XML и индексы подготавливаются заранее; загрузка каталога не выполняется при пользовательском запросе.</bpmn:documentation>
  </bpmn:dataStore>
  <bpmn:process id="Process_Ktru" name="Подбор позиции КТРУ и уточнение описания" isExecutable="false">
    <bpmn:documentation>Описательная BPMN-модель текущей реализации на коммите 1473edef775040f57ed19d12730ad5ac7198eb00, 11 октября 2026 года.
Область: основной сценарий поиска по описанию, результат анализа и повторный запрос. Независимый просмотр каталога и подготовка XML/эмбеддингов не входят в этот процесс.
Изменение относительно прежней реализации: React вызывает POST /analyze; сервер последовательно выполняет /search, /extract и сужение. UI отображает funnel, candidates и result_code.
Уточнение не продолжает прежний документ экстрактора: фронтенд изменяет строку query и повторяет весь POST /analyze, включая LLM.
Модель показывает фактическое поведение. Она не добавляет проверку физического смысла чисел, проверку всех обязательных характеристик, исправление опечаток или блокировку финального результата по issues экстрактора: этих проверок в текущем основном процессе нет.
Источники: web/src/App.tsx; web/src/api/search.ts; web/src/components/SearchResults.tsx; narrowing_candidates/api.py; search_service.py; search.py; characteristics_extractor/src/characteristics_extractor/{pipeline,extraction,normalization,app,llm}.py; narrowing_candidates/{analyze,funnel,narrow,match,hints,conflict_hints,repo}.py.
Техническая справка формата: https://www.omg.org/spec/BPMN/2.0/About-BPMN .</bpmn:documentation>
    <bpmn:laneSet id="Main_LaneSet">
      <bpmn:lane id="Lane_User" name="Пользователь">
        <bpmn:flowNodeRef>Main_Start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Main_Input</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Main_Read</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Main_End</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Main_Clarify</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Web" name="Веб-интерфейс · React">
        <bpmn:flowNodeRef>Main_Merge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Main_Send</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Main_ShowError</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Main_Display</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Main_Status</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Main_Resolved</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Main_Ambiguous</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Main_Conflict</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Main_Rewrite</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Server" name="Сервис анализа · FastAPI">
        <bpmn:flowNodeRef>SubProcess_Analyze</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Main_Error</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Main_Start" name="Нужен код КТРУ">
      <bpmn:outgoing>M01</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="Main_Input" name="Ввести описание товара">
      <bpmn:documentation>web/src/components/SearchBar.tsx; web/src/App.tsx: runSearch. Пустая после trim строка не отправляется; во время обработки кнопка поиска заблокирована.</bpmn:documentation>
      <bpmn:incoming>M01</bpmn:incoming>
      <bpmn:incoming>M17</bpmn:incoming>
      <bpmn:outgoing>M02</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Main_Merge" name="" gatewayDirection="Converging">
      <bpmn:incoming>M02</bpmn:incoming>
      <bpmn:incoming>M15</bpmn:incoming>
      <bpmn:outgoing>M03</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Main_Send" name="Отправить описание&#10;POST /analyze">
      <bpmn:documentation>web/src/api/search.ts: analyzeQuery. Передаётся только JSON {query}; web/src/App.tsx: runSearch сохраняет строку и вызывает mutation.</bpmn:documentation>
      <bpmn:incoming>M03</bpmn:incoming>
      <bpmn:outgoing>M04</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:subProcess id="SubProcess_Analyze" name="Подобрать КТРУ&#10;по описанию">
      <bpmn:documentation>narrowing_candidates/api.py: analyze_query. Развёрнутая схема находится на второй BPMN-плоскости Diagram_Analyze. Последовательность /search → /extract → загрузка позиций → convert_facts → analyze. Все изменения query проходят этот подпроцесс заново.</bpmn:documentation>
      <bpmn:incoming>M04</bpmn:incoming>
      <bpmn:outgoing>M05</bpmn:outgoing>
      <bpmn:laneSet id="Analyze_LaneSet">
        <bpmn:lane id="Lane_Api" name="Оркестратор · POST /analyze">
          <bpmn:flowNodeRef>Analyze_Start</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>Analyze_Return</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>Analyze_End</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="Lane_Search" name="Поиск · POST /search">
          <bpmn:flowNodeRef>Analyze_Search</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="Lane_Extract" name="Характеристики · POST /extract">
          <bpmn:flowNodeRef>Analyze_Context</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>Analyze_Llm</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>Analyze_Normalize</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="Lane_Narrow" name="Сужение кандидатов · analyze">
          <bpmn:flowNodeRef>Analyze_Facts</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>Analyze_Narrow</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>Analyze_Count</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>Analyze_Resolved</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>Analyze_Ambiguous</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>Analyze_Conflict</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>Analyze_Merge</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="Analyze_Start" name="Получен запрос">
        <bpmn:outgoing>A01</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:serviceTask id="Analyze_Search" name="Найти до 10 кандидатов&#10;BM25 + эмбеддинги + RRF">
        <bpmn:documentation>search_service.py; search.py. Канонизация по словарю, эмбеддинг intfloat/multilingual-e5-small; BM25 сначала AND, затем при недостатке результатов OR; семантический поиск; RRF; фильтр ACTIVE, actual=1, is_template=0 и дат применения; limit=10. Это последовательная реализация, поэтому параллельный шлюз не используется. Отсутствие эмбеддингов или сбой поискового HTTP-сервиса завершает запрос ошибкой.</bpmn:documentation>
        <bpmn:incoming>A01</bpmn:incoming>
        <bpmn:outgoing>A02</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="Analyze_Context" name="Собрать справочник&#10;характеристик кандидатов">
        <bpmn:documentation>repository.py и catalog.py: prepare_catalog. Загрузка определений только переданных кандидатов из SQLite, объединение эквивалентных определений, проверка полноты. Пустой список кандидатов или неполный справочник приводит к HTTP 409 экстрактора и затем HTTP 502 оркестратора, а не обязательно к бизнес-статусу conflict.</bpmn:documentation>
        <bpmn:incoming>A02</bpmn:incoming>
        <bpmn:outgoing>A03</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="Analyze_Llm" name="Извлечь свойства&#10;локальной LLM">
        <bpmn:documentation>extraction.py и llm.py. Вызов LM Studio /v1/chat/completions с JSON Schema. Модель задаётся LM_STUDIO_MODEL. Вход: исходное описание и ограниченный контекст КТРУ. Выход: search_target, facts, unsupported. Автоматических повторов LLM нет. Неравенства, диапазоны, отрицания и альтернативы считаются неподдерживаемыми ограничениями.</bpmn:documentation>
        <bpmn:incoming>A03</bpmn:incoming>
        <bpmn:outgoing>A04</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="Analyze_Normalize" name="Проверить ответ и привести&#10;значения к справочнику">
        <bpmn:documentation>extraction.bind_extraction, pipeline.finish_document, normalization.normalize_value, units.convert. Проверка JSON, выбранных ID и исходных фрагментов; качественные значения по справочнику; числа и ОКЕИ через Decimal/Pint. Атрибуты получают resolved, unknown или needs_clarification. Возвращаются attributes, clarifications, issues, status. Проверки диапазонов товара на этой стадии нет.</bpmn:documentation>
        <bpmn:incoming>A04</bpmn:incoming>
        <bpmn:outgoing>A05</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="Analyze_Facts" name="Загрузить позиции и отобрать&#10;сопоставленные факты">
        <bpmn:documentation>narrowing_candidates/api.py: load_positions(DB, codes), convert_facts. Позиции берутся из SQLite по найденным кодам и status=ACTIVE. Для сужения используются лишь attributes со status=resolved и непустыми normalized_value, characteristic_name. clarifications, issues и общий status экстрактора не участвуют в принятии решения и не передаются в AnalyzeResponse.</bpmn:documentation>
        <bpmn:incoming>A05</bpmn:incoming>
        <bpmn:outgoing>A06</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:businessRuleTask id="Analyze_Narrow" name="Применить очередной факт&#10;и записать before → after">
        <bpmn:documentation>analyze.py → run_funnel → narrow → value_matches. known_chars вычисляется до сужения. Факты применяются последовательно; на каждом шаге записывается число до и после. Неизвестное имя исключает все позиции; отсутствие характеристики/значений у конкретной позиции сохраняет её. Текст сравнивается точно, числа — с диапазонами; единицы внутри value_matches не конвертируются. При пустом facts воронка пуста, кандидаты сохраняются.</bpmn:documentation>
        <bpmn:incoming>A06</bpmn:incoming>
        <bpmn:outgoing>A07</bpmn:outgoing>
        <bpmn:multiInstanceLoopCharacteristics isSequential="true">
          <bpmn:loopCardinality xsi:type="bpmn:tFormalExpression">count(facts)</bpmn:loopCardinality>
        </bpmn:multiInstanceLoopCharacteristics>
      </bpmn:businessRuleTask>
      <bpmn:exclusiveGateway id="Analyze_Count" name="Сколько позиций&#10;осталось?" gatewayDirection="Diverging">
        <bpmn:incoming>A07</bpmn:incoming>
        <bpmn:outgoing>A08</bpmn:outgoing>
        <bpmn:outgoing>A09</bpmn:outgoing>
        <bpmn:outgoing>A10</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:scriptTask id="Analyze_Resolved" name="resolved&#10;Записать конечный код">
        <bpmn:documentation>analyze.py: len(left)==1 → status=resolved, result_code=left[0][code]. Дополнительная проверка неизвестных/неразрешённых атрибутов или полноты обязательных характеристик на этом шаге не выполняется.</bpmn:documentation>
        <bpmn:incoming>A08</bpmn:incoming>
        <bpmn:outgoing>A11</bpmn:outgoing>
      </bpmn:scriptTask>
      <bpmn:businessRuleTask id="Analyze_Ambiguous" name="ambiguous&#10;Подготовить уточнения">
        <bpmn:documentation>analyze.py; hints.py; conflict_hints.py. При len(left)&gt;1 result_code=null. Для неиспользованных характеристик генерируются допустимые варианты с remaining; сначала обязательные, затем минимальный средний остаток. Если разделяющих характеристик нет, возвращается kind=indistinguishable. Не все типы этих подсказок отображаются текущим UI.</bpmn:documentation>
        <bpmn:incoming>A09</bpmn:incoming>
        <bpmn:outgoing>A12</bpmn:outgoing>
      </bpmn:businessRuleTask>
      <bpmn:businessRuleTask id="Analyze_Conflict" name="conflict&#10;Найти причины и исправления">
        <bpmn:documentation>При len(left)==0: result_code=null, culprit — первый шаг обнуления. make_conflict_hints ищет минимальные конфликтующие наборы до трёх фактов, оценивает удаление/замену и выдаёт fixes, suggestions. Возможны kind=conflict, out_of_range, unit_mismatch, unknown_characteristic, value_not_allowed, no_candidates.</bpmn:documentation>
        <bpmn:incoming>A10</bpmn:incoming>
        <bpmn:outgoing>A13</bpmn:outgoing>
      </bpmn:businessRuleTask>
      <bpmn:exclusiveGateway id="Analyze_Merge" name="" gatewayDirection="Converging">
        <bpmn:incoming>A11</bpmn:incoming>
        <bpmn:incoming>A12</bpmn:incoming>
        <bpmn:incoming>A13</bpmn:incoming>
        <bpmn:outgoing>A14</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:serviceTask id="Analyze_Return" name="Вернуть результат анализа&#10;и извлечённые характеристики">
        <bpmn:documentation>AnalyzeResponse: funnel, candidates, status, result_code, culprit, hints, attributes. Исходные clarifications и issues экстрактора отсутствуют в данном ответе.</bpmn:documentation>
        <bpmn:incoming>A14</bpmn:incoming>
        <bpmn:outgoing>A15</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:endEvent id="Analyze_End" name="Ответ готов">
        <bpmn:incoming>A15</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:dataStoreReference id="DataRef_Ktru" name="КТРУ · SQLite&#10;индексы и характеристики" dataStoreRef="DataStore_Ktru"/>
      <bpmn:sequenceFlow id="A01" sourceRef="Analyze_Start" targetRef="Analyze_Search"/>
      <bpmn:sequenceFlow id="A02" sourceRef="Analyze_Search" targetRef="Analyze_Context"/>
      <bpmn:sequenceFlow id="A03" sourceRef="Analyze_Context" targetRef="Analyze_Llm"/>
      <bpmn:sequenceFlow id="A04" sourceRef="Analyze_Llm" targetRef="Analyze_Normalize"/>
      <bpmn:sequenceFlow id="A05" sourceRef="Analyze_Normalize" targetRef="Analyze_Facts"/>
      <bpmn:sequenceFlow id="A06" sourceRef="Analyze_Facts" targetRef="Analyze_Narrow"/>
      <bpmn:sequenceFlow id="A07" sourceRef="Analyze_Narrow" targetRef="Analyze_Count"/>
      <bpmn:sequenceFlow id="A08" sourceRef="Analyze_Count" targetRef="Analyze_Resolved" name="Одна">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">count(candidates) = 1</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="A09" sourceRef="Analyze_Count" targetRef="Analyze_Ambiguous" name="Несколько">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">count(candidates) &gt; 1</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="A10" sourceRef="Analyze_Count" targetRef="Analyze_Conflict" name="Ни одной">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">count(candidates) = 0</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="A11" sourceRef="Analyze_Resolved" targetRef="Analyze_Merge"/>
      <bpmn:sequenceFlow id="A12" sourceRef="Analyze_Ambiguous" targetRef="Analyze_Merge"/>
      <bpmn:sequenceFlow id="A13" sourceRef="Analyze_Conflict" targetRef="Analyze_Merge"/>
      <bpmn:sequenceFlow id="A14" sourceRef="Analyze_Merge" targetRef="Analyze_Return"/>
      <bpmn:sequenceFlow id="A15" sourceRef="Analyze_Return" targetRef="Analyze_End"/>
      <bpmn:textAnnotation id="Analyze_UnitsNote">
        <bpmn:text>Нормализация выполняется в Python.
LLM выделяет свойства и связывает
их с определениями КТРУ.</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:textAnnotation id="Analyze_FactsNote">
        <bpmn:text>В сужение передаются только
атрибуты со статусом resolved.
Неизвестные и неоднозначные
атрибуты остаются в ответе.</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="Analyze_FactsNoteLink" sourceRef="Analyze_Facts" targetRef="Analyze_FactsNote" associationDirection="None"/>
      <bpmn:association id="Data_Search" sourceRef="DataRef_Ktru" targetRef="Analyze_Search" associationDirection="One"/>
      <bpmn:association id="Data_Context" sourceRef="DataRef_Ktru" targetRef="Analyze_Context" associationDirection="One"/>
    </bpmn:subProcess>
    <bpmn:boundaryEvent id="Main_Error" name="Ошибка запроса" attachedToRef="SubProcess_Analyze" cancelActivity="true">
      <bpmn:documentation>Обобщённое отображение неуспешного HTTP-запроса или сетевого сбоя. requests.RequestException от /search или /extract преобразуется в HTTP 502. Входная валидация может вернуть 422; остальные ошибки также попадают в isError клиента.</bpmn:documentation>
      <bpmn:outgoing>M16</bpmn:outgoing>
      <bpmn:errorEventDefinition id="Main_ErrorDefinition"/>
    </bpmn:boundaryEvent>
    <bpmn:serviceTask id="Main_ShowError" name="Показать сообщение&#10;об ошибке запроса">
      <bpmn:documentation>web/src/App.tsx: search.isError. Пользователь может исправить строку либо повторно отправить исходный запрос. Автоматический цикл повтора в этой схеме не предполагается.</bpmn:documentation>
      <bpmn:incoming>M16</bpmn:incoming>
      <bpmn:outgoing>M17</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Main_Display" name="Показать характеристики&#10;и шаги сужения">
      <bpmn:documentation>SearchResults.tsx: attributes и funnel показываются после ответа /analyze. Изменение числа кандидатов отображается как before → after. Это итоговая воронка, а не поток промежуточных событий в реальном времени.</bpmn:documentation>
      <bpmn:incoming>M05</bpmn:incoming>
      <bpmn:outgoing>M06</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Main_Status" name="Результат анализа?" gatewayDirection="Diverging">
      <bpmn:incoming>M06</bpmn:incoming>
      <bpmn:outgoing>M07</bpmn:outgoing>
      <bpmn:outgoing>M08</bpmn:outgoing>
      <bpmn:outgoing>M09</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Main_Resolved" name="Показать найденную&#10;позицию КТРУ">
      <bpmn:documentation>status=resolved. Карточка загружается GET /item/{code}; кандидат с code=result_code получает метку «Лучшее совпадение». Пока карточка загружается или недоступна, показаны код и соответствующее сообщение; код результата не теряется.</bpmn:documentation>
      <bpmn:incoming>M07</bpmn:incoming>
      <bpmn:outgoing>M10</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Main_Ambiguous" name="Показать кандидатов&#10;и доступные уточнения">
      <bpmn:documentation>status=ambiguous. Карточки запрашиваются через GET /item/{code}. isAmbiguousHint пропускает подсказки с options и required без kind. Кнопка добавляет выбранное свойство в query. Подсказки kind=indistinguishable пока не выводятся отдельным блоком.</bpmn:documentation>
      <bpmn:incoming>M08</bpmn:incoming>
      <bpmn:outgoing>M12</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Main_Conflict" name="Показать конфликт&#10;и доступные действия">
      <bpmn:documentation>status=conflict. Заголовок конфликта показывается всегда. Блок объяснения и кнопки «Убрать» показываются только для hint.kind=conflict; прочие kinds, например out_of_range и no_candidates, этим блоком не отображаются. Кнопка заблокирована при blocked_by_other_conflict; карточки кандидатов скрыты.</bpmn:documentation>
      <bpmn:incoming>M09</bpmn:incoming>
      <bpmn:outgoing>M13</bpmn:outgoing>
    </bpmn:serviceTask>
